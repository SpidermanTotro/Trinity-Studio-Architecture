# Example environment variables for Trinity Studio Architecture
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=development
PORT=8085
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=trinity
DB_PASSWORD=trinity
DB_AUTH=trinity_auth
DB_CHARACTERS=trinity_characters
DB_WORLD=trinity_world

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
BCRYPT_ROUNDS=10

# Features
ENABLE_AI_DEBUGGER=true
ENABLE_LIVE_RELOAD=true
ENABLE_LEVEL_SCALING=true

# AI Debugger
AI_DEBUGGER_PORT=8086
AI_DEBUGGER_LOG_LEVEL=info

# Logging
LOG_LEVEL=info
LOG_DIRECTORY=logs

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
WORKERS=4

# Expansions (true/false)
EXPANSION_VANILLA=true
EXPANSION_TBC=true
EXPANSION_WOTLK=true
EXPANSION_CATACLYSM=false
EXPANSION_MOP=false
EXPANSION_WOD=false
EXPANSION_LEGION=false
EXPANSION_BFA=false
EXPANSION_SHADOWLANDS=false
EXPANSION_DRAGONFLIGHT=false

# Data Extraction
RETAIL_CLIENT_PATH=/path/to/retail/wow
DATA_OUTPUT_DIR=data/extracted

# Offline Mode
OFFLINE_MODE=false
OFFLINE_AUTO_SAVE=true
OFFLINE_SAVE_INTERVAL=300000

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=your-sentry-dsn
# ANALYTICS_KEY=your-analytics-key
